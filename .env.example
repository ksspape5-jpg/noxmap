# Serveur (API Express)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=3001
# Origines CORS autorisées (séparées par des virgules). Laissez vide pour les origines locales par défaut.
ALLOWED_ORIGINS=
# Limitation de débit : requêtes max par IP et par fenêtre.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Client (Vite)
VITE_API_BASE_URL=http://localhost:3001
VITE_REPO_URL=https://github.com/ksspape5-jpg/noxmap
